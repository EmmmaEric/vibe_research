# Copy to .env and fill in only what you need. Nothing here is required for the
# offline demo: the default run uses no network and no credentials.

# --- Real model provider (--provider anthropic) -----------------------------
# Also enables real web search (--search web).
# Alternatively run `ant auth login`, which stores a profile the SDK reads
# automatically -- an unset ANTHROPIC_API_KEY does not mean "no credentials".
# ANTHROPIC_API_KEY=sk-ant-...

# Override the default model (claude-opus-5-5) if you want a cheaper judge.
# RESEARCH_HARNESS_MODEL=claude-sonnet-5-5

# Keys are read from the environment only. They are never written to run
# artifacts, and the sandboxed experiment runner strips them from the
# environment it passes to experiment subprocesses.
